# ============================================================
# 配置示例文件(不含任何真实密钥)
#
# 用法:
#   1. 复制本文件为 .env        cp .env.example .env
#   2. 填入你自己的 API Key
#   3. .env 已在 .gitignore 中,不会被提交;本文件会被提交
#
# 说明:所有字段都来自 app/config/settings.py,键名必须与字段名一致才会生效。
#      写在这里但 settings.py 没有的键会被 pydantic-settings 静默忽略(extra="ignore")。
# ============================================================

# ---- 项目 ----
PROJECT_NAME=Smart Agent Platform
PROJECT_DESC=通用智能客服 Agent 平台:多 Agent 协作 + 混合检索 RAG + MCP 工具

# ---- LLM(对话 / 意图分类 / 生成回答)----
# 不设 provider 枚举:任何 OpenAI 兼容端点都由 LLM_BASE_URL 指定地址。
# 常用地址:
#   qwen(DashScope)  https://dashscope.aliyuncs.com/compatible-mode/v1
#   deepseek         https://api.deepseek.com/v1
#   zhipu            https://open.bigmodel.cn/api/paas/v4
#   火山方舟(豆包)   https://ark.cn-beijing.volces.com/api/v3
#   火山方舟 Plan    https://ark.cn-beijing.volces.com/api/plan/v1
LLM_MODEL=qwen-plus
LLM_API_KEY=
LLM_BASE_URL=

# ---- Embedding(向量检索用)----
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ---- 数据库 ----
DATABASE_URL=sqlite:///./data/smart_agent.db

# ---- 服务 ----
HOST=127.0.0.1
PORT=8000

# ---- 检索 ----
# 调用点不显式传 top_k 时:先召回 RETRIEVER_TOP_K 条,精排后返回 RERANK_TOP_K 条
# (实现取两者较小值;显式传 top_k 的请求始终以请求值为准)。
# 注意:评测口径固定 top_k=3,不跟随这两项,以保证历史报告可对比。
RETRIEVER_TOP_K=5
RERANK_TOP_K=3
RETRIEVER_WEIGHT_BM25=0.4
RETRIEVER_WEIGHT_VECTOR=0.6

# ---- 检索增强 ----
# rrf(倒数排名融合,推荐) | weighted(分数归一化加权,旧行为)
FUSION_STRATEGY=rrf
RRF_K=60
# 每一路召回的候选数,融合前先粗排到该规模
RETRIEVER_CANDIDATES=20
# 精排器拿到的候选数,需 >= RERANK_TOP_K 才有挑选空间
RERANK_CANDIDATES=20

# chroma(持久化,推荐) | memory(进程内,重启丢失)
VECTOR_STORE=chroma
# 默认 <项目根>/data/chroma,一般无需修改
# CHROMA_DIR=./data/chroma
# 向量写入批量大小
# CHROMA_BATCH_SIZE=64

# rule(规则,零依赖) | cross_encoder | llm | none
RERANKER_PROVIDER=rule
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base

# ---- 视觉模型(文档图片描述,可选)----
VISION_MODEL=qwen-vl-max
VISION_ENABLED=true
# 留空则复用 LLM_BASE_URL
# VISION_BASE_URL=

# ---- 文档摄取 ----
# 默认 <项目根>/data/uploads
# UPLOAD_DIR=./data/uploads
INGEST_MAX_MB=20
INGEST_CHUNK_SIZE=200
INGEST_CHUNK_OVERLAP=40
CAPTION_MAX_IMAGES=3
CAPTION_MAX_BYTES=2097152

# ---- 访问控制 ----
# 置空且 ALLOW_UNAUTHENTICATED=false 时,受保护接口返回 503(拒绝静默裸奔)
# 本地开发可临时设 ALLOW_UNAUTHENTICATED=true
API_KEY=
ALLOW_UNAUTHENTICATED=false
# 每分钟每 key+IP 的请求上限,0 表示关闭
RATE_LIMIT_PER_MINUTE=120

# ---- MCP ----
MCP_SERVER_URL=http://127.0.0.1:9000/mcp
MCP_ENABLED=true

# ---- 内置行业示例 ----
DEFAULT_TENANT_NAME=示例行业-健康养生
